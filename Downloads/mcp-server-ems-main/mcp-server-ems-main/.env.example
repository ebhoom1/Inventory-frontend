# Base URL of the existing EBHOOM EMS backend (no trailing slash needed).
# This backend is ALSO the OAuth authorization server.
EMS_API_BASE_URL=https://api.ocems.ebhoom.com

# Public URL of THIS MCP server (the OAuth "resource"). Used in the protected
# resource metadata and the WWW-Authenticate challenge sent to ChatGPT.
MCP_RESOURCE_URL=https://mcp.ebhoom.com

# OAuth issuer = the EMS backend's public URL (serves
# /.well-known/oauth-authorization-server, /oauth/authorize, /oauth/token).
OAUTH_ISSUER=https://api.ocems.ebhoom.com

# Port the MCP HTTP server listens on.
PORT=8787

# NOTE: There is NO EMS_AUTH_TOKEN anymore. With OAuth, each ChatGPT user
# authenticates as their own EMS account and ChatGPT sends their token per
# request as "Authorization: Bearer <token>". Remove any old EMS_AUTH_TOKEN
# from production .env.
